{% comment %}
  杂志主题把文章索引渲染成卡片栅格。参数与默认主题一致：posts、skip_id（跳过已作为头条展示的文章）
{% endcomment %}
<div class="mgrid">
  {% for post in posts %}
    {% if post.id == skip_id %}{% continue %}{% endif %}
    <article class="mcard">
      <a class="mcard-cover" href="{{ post.url }}" tabindex="-1" aria-hidden="true">{% if post.cover != "" %}<img src="{{ post.cover }}" alt="" loading="lazy" decoding="async">{% else %}<span>{{ post.title | slice: 0, 1 }}</span>{% endif %}</a>
      <div class="mcard-body">
        <p class="mcard-meta"><time datetime="{{ post.date | date_iso }}">{{ post.date | date_fmt: 'medium' }}</time>{% if post.pinned %}<mark>{{ 'pinned' | t }}</mark>{% endif %}</p>
        <h3 class="mcard-title"><a href="{{ post.url }}">{{ post.title }}</a></h3>
        {% if post.excerpt != "" %}<p class="mcard-excerpt">{{ post.excerpt }}</p>{% endif %}
        <p class="mcard-foot">{{ post.reading_minutes }} {{ 'minutes' | t }}</p>
      </div>
    </article>
  {% endfor %}
</div>
