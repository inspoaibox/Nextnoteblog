{% comment %}
  文章索引渲染成卡片栅格。参数与默认主题一致：posts、skip_id（跳过已作为头条展示的文章）
{% endcomment %}
<div class="agrid">
  {% for post in posts %}
  {% if post.id == skip_id %}{% continue %}{% endif %}
  <article class="acard">
    <a class="acard-cover" href="{{ post.url }}" tabindex="-1" aria-hidden="true">{% if post.cover != "" %}<img src="{{ post.cover }}" alt="" loading="lazy" decoding="async">{% else %}<span class="acard-glyph">{{ post.title | slice: 0, 1 }}</span>{% endif %}</a>
    <div class="acard-body">
      <p class="acard-meta"><time datetime="{{ post.date | date_iso }}">{{ post.date | date_fmt: 'medium' }}</time>{% if post.pinned %}<mark>{{ 'pinned' | t }}</mark>{% endif %}</p>
      <h3 class="acard-title"><a href="{{ post.url }}">{{ post.title }}</a></h3>
      {% if post.excerpt != "" %}<p class="acard-excerpt">{{ post.excerpt }}</p>{% endif %}
      <p class="acard-foot">{{ post.reading_minutes }} {{ 'minutes' | t }}</p>
    </div>
  </article>
  {% endfor %}
</div>
