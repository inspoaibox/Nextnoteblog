{% layout 'layout' %}
{% block content %}
{% if preview %}<div class="banner banner-preview">{{ 'preview_banner' | t }}</div>{% endif %}
<div class="frame">
  <article class="post">
    <header class="post-header">
      <h1 class="post-title hash" data-hash="#">{{ content.title }}</h1>
    </header>
    <div class="post-content">{{ content.html | raw }}</div>
  </article>
</div>
{% endblock %}
