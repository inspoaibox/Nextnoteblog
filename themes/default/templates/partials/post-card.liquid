<article class="card{% if post.cover != "" %} has-cover{% endif %}">
  <div class="card-body">
    <h2 class="card-title">
      <a href="{{ post.url }}">{{ post.title }}</a>
      {% if post.pinned %}<span class="badge">{{ 'pinned' | t }}</span>{% endif %}
    </h2>
    {% if post.excerpt != "" %}<p class="card-excerpt">{{ post.excerpt }}</p>{% endif %}
    <p class="meta">
      <time datetime="{{ post.date | date_iso }}">{{ post.date | date_fmt }}</time>
      <span>{{ post.reading_minutes }} {{ 'minutes' | t }}</span>
      {% if post.views > 0 %}<span>{{ post.views | num }} {{ 'views' | t }}</span>{% endif %}
    </p>
  </div>
  {% if post.cover != "" %}
    <a class="card-cover" href="{{ post.url }}" tabindex="-1" aria-hidden="true"><img src="{{ post.cover }}" alt="" loading="lazy" decoding="async"></a>
  {% endif %}
</article>
