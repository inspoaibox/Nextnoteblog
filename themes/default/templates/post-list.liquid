{% layout 'layout' %}
{% block content %}
<div class="frame">
  {% render 'partials/crumbs', crumbs: crumbs %}
  <header class="list-header">
    <h1 class="hash" data-hash="#">{{ heading }}</h1>
    {% if intro and intro != "" %}<p class="list-intro">{{ intro }}</p>{% endif %}
    <p>{{ 'post_count' | t | replace: '{n}', pagination.total }}</p>
  </header>
  {% if posts.size == 0 %}
    {% render 'partials/empty' %}
  {% else %}
    {% render 'partials/post-index', posts: posts, skip_id: 0 %}
    {% render 'partials/pagination', pagination: pagination %}
  {% endif %}
</div>
{% endblock %}
