{
  "id": "macos",
  "name": "macOS 风格",
  "version": "1.0.0",
  "author": "nexemcblog",
  "description": "把整个站点做成一台 macOS 风格的桌面：顶部菜单栏、底部程序坞，文章在带红黄绿按钮的访达窗口里浏览，窗口可拖动、最小化、缩放与关闭。支持浅色与深色。",
  "requires": ">=1.0.0",
  "settings": [
    {
      "key": "accent",
      "type": "select",
      "label": "强调色",
      "default": "blue",
      "options": [
        {
          "value": "blue",
          "label": "蓝色"
        },
        {
          "value": "purple",
          "label": "紫色"
        },
        {
          "value": "pink",
          "label": "粉色"
        },
        {
          "value": "orange",
          "label": "橙色"
        },
        {
          "value": "green",
          "label": "绿色"
        },
        {
          "value": "graphite",
          "label": "石墨色"
        }
      ]
    },
    {
      "key": "wallpaper",
      "type": "select",
      "label": "桌面壁纸",
      "default": "dune",
      "options": [
        {
          "value": "dune",
          "label": "暖色沙丘"
        },
        {
          "value": "ridge",
          "label": "蓝色山脊"
        },
        {
          "value": "dusk",
          "label": "紫色暮霭"
        }
      ]
    },
    {
      "key": "magnify",
      "type": "boolean",
      "label": "程序坞图标悬停放大",
      "default": true
    }
  ]
}
