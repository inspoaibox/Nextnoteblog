{% comment %}
  文章索引渲染成“文件列表”：图标（有封面时是缩略图）、名称与摘要、发布日期、篇幅。
  参数与默认主题一致：posts、skip_id、flat（不按年份分组）
{% endcomment %}
{% assign group = "" %}
<div class="files">
  <div class="files-head" aria-hidden="true"><span>{{ 'col_name' | t }}</span><span>{{ 'col_date' | t }}</span><span>{{ 'col_length' | t }}</span></div>
  {% for post in posts %}
    {% if post.id == skip_id %}{% continue %}{% endif %}
    {% if post.pinned %}{% assign label = 'pinned' | t %}{% else %}{% assign label = post.date | date_fmt: 'year' %}{% endif %}
    {% if flat %}{% assign label = group %}{% endif %}
    {% if label != group %}
      {% assign group = label %}
      <h2 class="files-group">{{ label }}</h2>
    {% endif %}
    <article class="file">
      <span class="file-ico{% if post.cover != "" %} has-thumb{% endif %}" aria-hidden="true">{% if post.cover != "" %}<img src="{{ post.cover }}" alt="" loading="lazy" decoding="async">{% endif %}</span>
      <div class="file-main">
        <h3 class="file-name"><a href="{{ post.url }}">{{ post.title }}</a></h3>
        {% if post.excerpt != "" %}<p class="file-desc">{{ post.excerpt }}</p>{% endif %}
      </div>
      <time class="file-date" datetime="{{ post.date | date_iso }}">{{ post.date | date_fmt: 'short' }}</time>
      <span class="file-size">{{ post.reading_minutes }} {{ 'minutes' | t }}</span>
    </article>
  {% endfor %}
</div>
