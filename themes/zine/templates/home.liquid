{% layout 'layout' %}
{% block content %}
<div class="frame">
  {% comment %} 站名已经在页头显示，这里只给读屏软件和搜索引擎一个页面标题，不重复显示 {% endcomment %}
  <h1 class="sr-only">{{ site.name }}</h1>
  {% if pagination.page == 1 %}{% if site.tagline != "" or site.description != "" %}
  <section class="zmast">
    {% if site.tagline != "" %}<p class="zmast-tagline">{{ site.tagline }}</p>{% endif %}
    {% if site.description != "" %}<p class="zmast-intro">{{ site.description }}</p>{% endif %}
  </section>
  {% endif %}{% endif %}

  {% if posts.size == 0 %}
    {% render 'partials/empty' %}
  {% else %}
    {% comment %} 首页第一页：最新的一篇非置顶文章做头条 {% endcomment %}
    {% assign lead = nil %}
    {% if pagination.page == 1 %}
      {% for p in posts %}{% unless p.pinned %}{% assign lead = p %}{% break %}{% endunless %}{% endfor %}
    {% endif %}
    {% if lead %}
    <article class="zlead">
      <a class="zlead-cover" href="{{ lead.url }}" tabindex="-1" aria-hidden="true">{% if lead.cover != "" %}<img src="{{ lead.cover }}" alt="" decoding="async">{% else %}<span class="zcard-glyph">{{ lead.title | slice: 0, 1 }}</span>{% endif %}</a>
      <div class="zlead-body">
        <p class="zcard-meta"><time datetime="{{ lead.date | date_iso }}">{{ lead.date | date_fmt }}</time></p>
        <h2 class="zlead-title"><a href="{{ lead.url }}">{{ lead.title }}</a></h2>
        {% if lead.excerpt != "" %}<p class="zlead-excerpt">{{ lead.excerpt }}</p>{% endif %}
        <p class="zcard-foot">{{ lead.reading_minutes }} {{ 'minutes' | t }}</p>
      </div>
    </article>
    {% endif %}

    {% if lead %}{% render 'partials/post-index', posts: posts, skip_id: lead.id %}{% else %}{% render 'partials/post-index', posts: posts, skip_id: 0 %}{% endif %}
    {% render 'partials/pagination', pagination: pagination %}
  {% endif %}

  {% if pagination.page == 1 %}
  {% if categories.size > 0 or tags.size > 0 %}
  <section class="browse">
    {% if categories.size > 0 %}
    <div>
      <h2>{{ 'categories' | t }}</h2>
      <ul class="tag-cloud">
        {% for cat in categories %}<li><a href="{{ cat.url }}">{{ cat.name }}</a><span>{{ cat.count }}</span></li>{% endfor %}
      </ul>
    </div>
    {% endif %}
    {% if tags.size > 0 %}
    <div>
      <h2>{{ 'tags' | t }}</h2>
      <ul class="tag-cloud">
        {% for tag in tags %}<li><a href="{{ tag.url }}">{{ tag.name }}</a><span>{{ tag.count }}</span></li>{% endfor %}
      </ul>
    </div>
    {% endif %}
  </section>
  {% endif %}
  {% endif %}
</div>
{% endblock %}
