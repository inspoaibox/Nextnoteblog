{% layout 'layout' %}
{% block content %}
<div class="frame">
  <div class="notfound">
    <h1 class="hash" data-hash="#">404</h1>
    <p class="notfound-title">{{ 'not_found_title' | t }}</p>
    <p>{{ 'not_found_hint' | t }}</p>
    <p><a href="{{ '/' | url }}">{{ 'back_home' | t }}</a></p>
  </div>
</div>
{% endblock %}
