{
  "id": "zine",
  "name": "拼贴",
  "version": "1.0.0",
  "author": "nexemcblog",
  "description": "自制小报风格：大色块背景、粗黑描边与硬投影的卡片、倾斜的贴纸标签和顶部滚动字幕。",
  "requires": ">=1.0.0",
  "settings": [
    {
      "key": "bg",
      "type": "color",
      "label": "背景色",
      "default": "#2338ff"
    },
    {
      "key": "accent",
      "type": "color",
      "label": "贴纸色",
      "hint": "标语、标签、滚动字幕的底色",
      "default": "#ff5a36"
    },
    {
      "key": "tilt",
      "type": "boolean",
      "label": "卡片轻微倾斜",
      "default": true
    },
    {
      "key": "ticker",
      "type": "boolean",
      "label": "顶部滚动字幕",
      "hint": "访客系统设置了“减少动态效果”时停止滚动",
      "default": true
    }
  ]
}
