{% comment %}
  文章索引：按年份分组，置顶文章单独成组。
  参数：posts（文章数组）、skip_id（要跳过的文章 id，首页用来跳过已作为头条展示的那篇）
{% endcomment %}
{% assign group = "" %}
<div class="index">
  {% for post in posts %}
    {% if post.id == skip_id %}{% continue %}{% endif %}
    {% if post.pinned %}{% assign label = 'pinned' | t %}{% else %}{% assign label = post.date | date_fmt: 'year' %}{% endif %}
    {% if flat %}{% assign label = group %}{% endif %}
    {% if label != group %}
      {% assign group = label %}
      <h2 class="index-group">{{ label }}</h2>
    {% endif %}
    <article class="row">
      <time class="row-date" datetime="{{ post.date | date_iso }}">{% if post.pinned or flat %}{{ post.date | date_fmt: 'short' }}{% else %}{{ post.date | date_fmt: 'md' }}{% endif %}</time>
      <div class="row-main">
        <h3 class="row-title"><a href="{{ post.url }}">{{ post.title }}</a></h3>
        {% if post.excerpt != "" %}<p class="row-excerpt">{{ post.excerpt }}</p>{% endif %}
        <p class="row-meta">{{ post.reading_minutes }} {{ 'minutes' | t }}{% if post.views > 0 %}<span>{{ post.views | num }} {{ 'views' | t }}</span>{% endif %}</p>
      </div>
      {% if post.cover != "" %}
        <a class="row-cover" href="{{ post.url }}" tabindex="-1" aria-hidden="true"><img src="{{ post.cover }}" alt="" loading="lazy" decoding="async"></a>
      {% endif %}
    </article>
  {% endfor %}
</div>
