<!doctype html>
<html lang="{{ site.locale }}" data-mode="{{ site.appearance }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page.title }}</title>
  {% if page.description and page.description != "" %}<meta name="description" content="{{ page.description }}">{% endif %}
  {% if page.noindex %}<meta name="robots" content="noindex">{% endif %}
  {% if page.canonical and page.canonical != "" %}<link rel="canonical" href="{{ page.canonical }}">{% endif %}
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ page.title }}">
  <meta property="og:type" content="{% if page.type == 'post' %}article{% else %}website{% endif %}">
  {% if page.description and page.description != "" %}<meta property="og:description" content="{{ page.description }}">{% endif %}
  {% if page.image and page.image != "" %}<meta property="og:image" content="{{ site.url }}{{ page.image }}">{% endif %}
  <meta name="color-scheme" content="{% if site.appearance == 'auto' %}light dark{% else %}{{ site.appearance }}{% endif %}">
  {% for alt in hreflang %}<link rel="alternate" hreflang="{{ alt.code }}" href="{{ alt.href }}">
  {% endfor %}<link rel="alternate" type="application/atom+xml" title="{{ site.name }}" href="{{ site.feed_url }}">
  <link rel="stylesheet" href="{{ 'style.css' | asset_url }}">
  <style>
    :root { --side: {{ theme.config.sidebar }}; }
    html[data-mode="light"] { --link: {{ theme.config.accent }}; --marker: color-mix(in srgb, {{ theme.config.accent }} 16%, transparent); }
    @media (prefers-color-scheme: light) { html[data-mode="auto"] { --link: {{ theme.config.accent }}; --marker: color-mix(in srgb, {{ theme.config.accent }} 16%, transparent); } }
  </style>
</head>
<body class="page-{{ page.type }}" data-locale="{{ site.locale }}" data-t-copied="{{ 'copied' | t }}" data-t-expand="{{ 'expand_code' | t }}" data-t-image="{{ 'image' | t }}">
  <a class="skip-link" href="#main">{{ 'skip_to_content' | t }}</a>
  <div class="progress" aria-hidden="true"><span></span></div>
  {% if languages.size > 1 %}
  <div class="lang-hint" data-text="{{ 'lang_suggest' | t }}" hidden>
    <span class="lang-hint-text"></span>
    <a class="lang-hint-go" href="#">{{ 'lang_suggest_go' | t }}</a>
    <button class="lang-hint-close" type="button">{{ 'lang_suggest_dismiss' | t }}</button>
  </div>
  {% endif %}
  <div class="shell">
    <aside class="side">
      <a class="brand" href="{{ '/' | url }}">{{ site.name }}</a>
      <form class="site-search" action="{{ '/search' | url }}" method="get" role="search">
        <input type="search" name="q" value="{{ query }}" placeholder="{{ 'search_placeholder' | t }}" aria-label="{{ 'search' | t }}" autocomplete="off">
      </form>
      <nav class="side-nav" aria-label="{{ 'main_nav' | t }}">
        {% for item in nav.header %}<a href="{{ item.url }}"{% if item.current %} aria-current="page"{% endif %}{% if item.new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.label }}</a>{% endfor %}
      </nav>
      {% if theme.config.show_tree and site.categories.size > 0 %}
      <details class="side-tree" open>
        <summary>{{ 'categories' | t }}</summary>
        <ul>
          {% for cat in site.categories %}
          <li>
            <a href="{{ cat.url }}">{{ cat.name }}</a>
            {% if cat.children.size > 0 %}
            <ul>
              {% for child in cat.children %}
              <li>
                <a href="{{ child.url }}">{{ child.name }}</a>
                {% if child.children.size > 0 %}<ul>{% for leaf in child.children %}<li><a href="{{ leaf.url }}">{{ leaf.name }}</a></li>{% endfor %}</ul>{% endif %}
              </li>
              {% endfor %}
            </ul>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
      </details>
      {% endif %}
      {% if languages.size > 1 %}
      <nav class="lang-switch" aria-label="{{ 'language' | t }}">
        {% for lang in languages %}{% if lang.current %}<span aria-current="true" lang="{{ lang.code }}">{{ lang.name }}</span>{% else %}<a href="{{ lang.href }}" hreflang="{{ lang.code }}" lang="{{ lang.code }}" data-lang="{{ lang.code }}"{% unless lang.available %} data-missing title="{{ 'lang_missing' | t }}"{% endunless %}>{{ lang.name }}</a>{% endif %}{% endfor %}
      </nav>
      {% endif %}
    </aside>
    <div class="main-col">
      <main id="main">
        {% block content %}{% endblock %}
      </main>
      <footer class="site-footer">
        <div class="frame">
      {% if nav.footer.size > 0 %}
      <nav class="footer-nav" aria-label="{{ 'footer_nav' | t }}">
        {% for item in nav.footer %}<a href="{{ item.url }}"{% if item.new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ item.label }}</a>{% endfor %}
      </nav>
      {% endif %}
      <p>© {{ site.year }} {{ site.name }}</p>
      {% if site.footer_text and site.footer_text != "" %}<p>{{ site.footer_text }}</p>{% endif %}
      {% if site.icp and site.icp != "" %}<p><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">{{ site.icp }}</a></p>{% endif %}
        </div>
      </footer>
    </div>
  </div>
  <button class="to-top" type="button" aria-label="{{ 'back_to_top' | t }}" hidden>↑</button>
  <script src="{{ 'main.js' | asset_url }}" defer></script>
</body>
</html>
