{
  "name": "@nexemc/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src --watch-path=../../packages/markdown/src --import tsx src/server.ts --port=3100",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test src/app.test.ts src/app-m2.test.ts src/app-m3.test.ts src/app-m4.test.ts src/app-m5.test.ts src/lib/slug.test.ts",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@nexemc/markdown": "workspace:*",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.12",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "liquidjs": "^10.30.1",
    "pinyin-pro": "^3.29.5",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
